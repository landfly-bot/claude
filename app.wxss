page {
  --brand: #2f80ed;
  --brand-light: #56ccf2;
  --text: #1f2733;
  --text-weak: #8a94a6;
  --card: #ffffff;
  background: linear-gradient(180deg, #eef5ff 0%, #f7fbff 45%, #f7f8fa 100%);
  background-attachment: fixed;
  min-height: 100vh;
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.muted {
  color: var(--text-weak);
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.empty {
  text-align: center;
  color: var(--text-weak);
  font-size: 26rpx;
  padding: 48rpx 0;
}
