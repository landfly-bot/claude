.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: var(--text-weak);
}

.tab.active {
  background: var(--brand);
  color: #fff;
  font-weight: 500;
}

.chart {
  position: relative;
  height: 320rpx;
  padding-bottom: 40rpx;
}

.bars {
  display: flex;
  align-items: flex-end;
  height: 100%;
}

.bar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 60%;
  max-width: 28rpx;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.28);
  transition: height 0.4s ease;
}

.bar.reached {
  background: linear-gradient(180deg, var(--brand-light) 0%, var(--brand) 100%);
}

.bar.today {
  box-shadow: 0 0 0 3rpx rgba(47, 128, 237, 0.25);
}

.bar-label {
  font-size: 20rpx;
  color: var(--text-weak);
  margin-top: 12rpx;
  height: 28rpx;
}

.goal-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  margin-bottom: 40rpx;
  border-top: 2rpx dashed rgba(47, 128, 237, 0.35);
}

.goal-tag {
  position: absolute;
  right: 0;
  top: -30rpx;
  font-size: 20rpx;
  color: var(--brand);
}

.chart-tip {
  display: block;
  text-align: center;
  margin-top: 8rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 50%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-value {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--brand);
}

.grid-label {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
}

.best {
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f5;
  font-size: 26rpx;
  color: var(--text-weak);
  text-align: center;
}
